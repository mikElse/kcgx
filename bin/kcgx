#!/usr/bin/env bash
# kcgx — open the cockpit: live traffic, ATC audio with transcription, a shell.
#
#   adsb-tui        │  squelch
#                   ├──────────
#                   │  $SHELL
#
# Every splitter is drag-resizable; the sizes below are starting positions.
# Run it again from anywhere to reattach to a running cockpit.
#
# Environment overrides (mostly test seams):
#   KCGX_SESSION       session name                    (default: kcgx)
#   KCGX_SOCKET        tmux socket name, for isolation (default: tmux's own)
#   KCGX_SIZE          WIDTHxHEIGHT instead of the real terminal
#   KCGX_DETACHED      build the session but do not attach
#   KCGX_ADSB_CMD      command for the left pane       (default: adsb-tui)
#   KCGX_SQUELCH_CMD   command for the squelch pane
#   KCGX_AIRPORT_CMD   command that resolves/picks an airport
#   KCGX_STATE_PATH    where the picked airport is remembered; read by the
#                      Python side, but inherited through this script, so
#                      setting it here reaches kcgx-airport three processes
#                      down (default: ~/.local/state/kcgx/airport)
#   KCGX_SQUELCH_COLS  width of the right column       (default: 48)
#   KCGX_SHELL_ROWS    height of the shell pane        (default: 12)
#   KCGX_MIN_COLS      refuse to build below this      (default: 100)

set -euo pipefail

SESSION="${KCGX_SESSION:-kcgx}"

# Resolve symlinks before deriving the repo root. The intended install is a
# symlink in ~/bin, and ${BASH_SOURCE[0]} reports the path used to invoke the
# script, not the link's target — so this would otherwise resolve to ~ and go
# looking for ~/kcgx.tmux.conf. `readlink -f` is not portable to older macOS,
# hence the loop.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *) self="$(cd -P "$(dirname "$self")" && pwd)/$target" ;;
    esac
done
REPO="$(cd -P "$(dirname "$self")/.." && pwd)"
CONF="$REPO/kcgx.tmux.conf"

SQUELCH_COLS="${KCGX_SQUELCH_COLS:-48}"
SHELL_ROWS="${KCGX_SHELL_ROWS:-12}"
MIN_COLS="${KCGX_MIN_COLS:-100}"

die() { printf 'kcgx: %s\n' "$*" >&2; exit 1; }

command -v tmux >/dev/null 2>&1 ||
    die "tmux not found. Install it with: brew install tmux"

# `split-window -l <cells>` needs tmux 3.1+; older tmux only takes percentages.
tmux_version="$(tmux -V | grep -oE '[0-9]+\.[0-9]+' | head -1)"
awk -v v="$tmux_version" 'BEGIN {
    split(v, p, ".");
    exit !(p[1] > 3 || (p[1] == 3 && p[2] >= 1))
}' || die "tmux $tmux_version is too old; kcgx needs 3.1 or newer."

# One argv for every tmux call, so the socket and config stay consistent.
# It has to be an array rather than only a function: `exec` bypasses shell
# functions and searches PATH, so `exec tm ...` dies with "tm: not found".
TMUX_CMD=(tmux)
if [ -n "${KCGX_SOCKET:-}" ]; then
    TMUX_CMD+=(-L "$KCGX_SOCKET")
fi
TMUX_CMD+=(-f "$CONF")

tm() {
    "${TMUX_CMD[@]}" "$@"
}

# `-f` above is only honoured when the command *starts* the tmux server. If a
# server is already running, it is ignored outright — which silently cost us
# mouse mode and remain-on-exit, the two things this whole thing exists for.
# Sourcing explicitly once a server exists makes the config apply every time,
# and means editing kcgx.tmux.conf takes effect without killing the server.
apply_config() {
    tm source-file "$CONF"
}

ADSB_CMD="${KCGX_ADSB_CMD:-adsb-tui}"
# tmux runs the pane command through a shell, so quote the path: a repo cloned
# somewhere with a space in it would otherwise word-split.
SQUELCH_CMD="${KCGX_SQUELCH_CMD:-uv run --project '$REPO' squelch}"

# The Python side is reached only through this one command, so bin/kcgx
# never parses the airport dataset and src/kcgx/ never runs a tmux command.
if [ -n "${KCGX_AIRPORT_CMD:-}" ]; then
    # Word-split deliberately: this is a test seam holding a whole command.
    # shellcheck disable=SC2206
    AIRPORT_CMD=($KCGX_AIRPORT_CMD)
else
    AIRPORT_CMD=(uv run --project "$REPO" kcgx-airport)
fi

ICAO="" LAT="" LON="" LABEL=""

# Fills ICAO/LAT/LON/LABEL from `kcgx-airport <mode> [query]`. Returns
# non-zero when the mode declined (a cancelled picker) or failed, leaving
# the four variables empty so callers can degrade instead of guessing.
airport_record() {
    local out status=0
    # 2, not 1: an unwritable TMPDIR is a failure, and returning 1 would tell
    # the caller the user had pressed escape -- silently, successfully, and
    # wrongly. 1 means "declined" and nothing else.
    out="$(mktemp)" || return 2
    # `cmd || status=$?` rather than `if ! cmd`: inside the body of an `if !`
    # the `!` has already flipped the status, so $? there reads 0 and a
    # cancelled pick (1) would come back as success.
    # Neither stream is redirected, and both halves of that matter. Textual
    # writes its frames to sys.__stderr__, so redirecting stderr sends the
    # whole picker to /dev/null -- while stdin stays connected, so enter
    # still blindly selects something. And it *measures* the terminal with
    # shutil.get_terminal_size(), which reads sys.__stdout__, so redirecting
    # stdout leaves it drawing in the right place at the wrong size: it
    # falls back to 80x24, paints a frame bigger than the 64x20 popup, the
    # terminal scrolls, and the airport rows end up off screen. Both look
    # identical from here -- a working search that moves the cockpit
    # somewhere the user never saw.
    #
    # Nothing is lost by leaving stdout alone. --out is always passed above,
    # so the record goes to the file and never to stdout; keeping it off the
    # terminal is --out's job, not the redirect's. Nor did the redirect
    # suppress `uv` progress on a cold environment: uv writes that to
    # stderr, which we cannot redirect either. One spelling for both modes,
    # because a second spelling is how launch and switch drift apart.
    "${AIRPORT_CMD[@]}" "$@" --out "$out" || status=$?
    if [ "$status" -ne 0 ]; then
        rm -f "$out"
        return "$status"
    fi
    IFS=$'\t' read -r ICAO LAT LON LABEL < "$out" || true
    rm -f "$out"
    # 1 is reserved for "the user declined", so a short or empty record --
    # which nobody asked for -- reports itself as an error instead.
    if [ -z "$ICAO" ] || [ -z "$LAT" ] || [ -z "$LON" ]; then
        ICAO="" LAT="" LON="" LABEL=""
        return 2
    fi
}

# One spelling of each pane command, used by both the initial build and
# every retarget. A second spelling is how launch and switch drift apart.
adsb_cmd() {  # $1=lat $2=lon
    if [ -n "$1" ] && [ -n "$2" ]; then
        printf '%s --site-lat %s --site-lon %s' "$ADSB_CMD" "$1" "$2"
    else
        printf '%s' "$ADSB_CMD"
    fi
}

squelch_cmd() {  # $1=icao
    if [ -n "$1" ]; then
        printf '%s --icao %s' "$SQUELCH_CMD" "$1"
    else
        printf '%s' "$SQUELCH_CMD"
    fi
}

retarget() {  # $1=icao $2=lat $3=lon
    tm respawn-pane -k -t "=$SESSION:cockpit.0" "$(adsb_cmd "$2" "$3")"
    tm respawn-pane -k -t "=$SESSION:cockpit.1" "$(squelch_cmd "$1")"
}

usage() {
    cat <<'USAGE'
kcgx — open the cockpit: live traffic, ATC audio, a shell.

  kcgx             open the cockpit, or reattach to a running one
  kcgx go [query]  search for an airport and point both panes at it
  kcgx stop        shut the cockpit down
  kcgx --help      this

Drag any pane border with the mouse to resize. Ctrl-b then a opens the
airport search; Ctrl-b then r respawns a pane that has died.
USAGE
}

case "${1:-}" in
    stop)
        # Kill only our session. The tmux server may be running sessions that
        # have nothing to do with kcgx, so kill-server is not an option.
        if tm has-session -t "=$SESSION" 2>/dev/null; then
            tm kill-session -t "=$SESSION"
            printf 'kcgx: stopped.\n'
        else
            printf 'kcgx: not running.\n'
        fi
        exit 0
        ;;
    go)
        shift
        if ! tm has-session -t "=$SESSION" 2>/dev/null; then
            die "not running. Open the cockpit first with: kcgx"
        fi
        status=0
        airport_record pick "$@" || status=$?
        # Cancelled: the cockpit is fine as it is, moving it would be worse
        # than doing nothing, and the user already knows they escaped. Any
        # other failure is a real one and must not masquerade as a cancel.
        [ "$status" -eq 1 ] && exit 0
        [ "$status" -eq 0 ] ||
            die "airport search failed (exit $status); nothing was changed."
        retarget "$ICAO" "$LAT" "$LON"
        printf 'kcgx: %s — %s\n' "$ICAO" "$LABEL"
        exit 0
        ;;
    -h | --help | help)
        usage
        exit 0
        ;;
    "") ;;
    *)
        printf 'kcgx: unknown command %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

# Already running? Attach instead of building a second one, so squelch keeps its
# transcript and you don't pay the model load again.
if tm has-session -t "=$SESSION" 2>/dev/null; then
    apply_config
    if [ -n "${KCGX_DETACHED:-}" ]; then
        exit 0
    fi
    if [ -n "${TMUX:-}" ]; then
        exec "${TMUX_CMD[@]}" switch-client -t "=$SESSION"
    fi
    exec "${TMUX_CMD[@]}" attach-session -t "=$SESSION"
fi

# Measure with stty, not tput. `tput cols` does not fail when it cannot see a
# terminal — it silently returns terminfo's default (80 for xterm-256color),
# which looks exactly like a real measurement. Worse, inside a command
# substitution its stdout is a pipe, so it cannot ioctl the real terminal even
# when there is one, and reports 80 for a 222-column window. `stty size` reads
# the tty directly and fails loudly when there is none.
if [ -n "${KCGX_SIZE:-}" ]; then
    cols="${KCGX_SIZE%%x*}"
    rows="${KCGX_SIZE##*x}"
elif winsize="$(stty size 2>/dev/null </dev/tty)"; then
    rows="${winsize%% *}"
    cols="${winsize##* }"
elif [ -n "${COLUMNS:-}" ] && [ -n "${LINES:-}" ]; then
    cols="$COLUMNS"
    rows="$LINES"
else
    die "not running in a terminal, so there is nothing to attach to." \
        "Run kcgx from a terminal, or set KCGX_SIZE=WIDTHxHEIGHT to build a" \
        "detached session."
fi

case "$cols$rows" in
    *[!0-9]* | "") die "could not determine terminal size." ;;
esac

# Below this there isn't room for both a readable traffic table and squelch's
# 48-column pane, and the result is worse than not launching.
if [ "$cols" -lt "$MIN_COLS" ]; then
    die "terminal is $cols columns; kcgx needs at least $MIN_COLS" \
        "(squelch alone wants $SQUELCH_COLS)."
fi

# A resolver failure must not cost you the cockpit: both panes fall back to
# their own configuration, which is what they did before this existed.
if ! airport_record resolve; then
    ICAO="" LAT="" LON=""
fi

tm new-session -d -s "$SESSION" -n cockpit -x "$cols" -y "$rows" "$(adsb_cmd "$LAT" "$LON")"
apply_config
tm split-window -h -l "$SQUELCH_COLS" -t "=$SESSION:cockpit.0" "$(squelch_cmd "$ICAO")"
tm split-window -v -l "$SHELL_ROWS" -t "=$SESSION:cockpit.1"

# Land on squelch rather than the shell — it's the pane you read.
tm select-pane -t "=$SESSION:cockpit.1"

if [ -n "${KCGX_DETACHED:-}" ]; then
    exit 0
fi

exec "${TMUX_CMD[@]}" attach-session -t "=$SESSION"
