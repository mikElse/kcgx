#!/usr/bin/env bash
# Stands in for the radar pane when its command is not installed.
#
# Not a fallback radar — there is nothing to fall back to. It exists so the
# left pane answers the three questions a `command not found` leaves open:
# whether the cockpit is broken (it is not), where the missing binary comes
# from, and how to get out of here.
#
# It blocks rather than exiting, deliberately. `remain-on-exit` would keep
# the text on screen, but the radar pane is the *only* pane at the moment
# `new-session` creates it — a command that exits before kcgx.tmux.conf has
# been sourced takes the whole session with it. Staying alive removes the
# race instead of racing it faster.
#
# Lines are kept under 46 columns: the radar pane gets whatever is left after
# squelch's 48, which at kcgx's 100-column minimum is 51.

missing="${1:-adsb-tui}"

cat <<MSG

  No radar: $missing is not installed.

  It is optional, and nothing else is
  wrong — audio is running on the right,
  status above it.

  To add it, from the kcgx repo:

      ./setup.sh

  which downloads the published release.
  Then press Ctrl-b r here to fill this
  pane in.

  Ctrl-b q  shut the cockpit down
  Ctrl-b d  detach, leaving it running

MSG

# Idle without holding stdin: a `read` here would swallow the first key the
# user pressed at the cockpit.
while :; do
    sleep 3600
done
