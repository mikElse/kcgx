Screen {
    layout: vertical;
}

#header {
    height: 1;
    background: $panel;
}

#meter {
    height: 1;
}

#messages {
    height: 1fr;
    border-top: solid $primary;
    padding: 0 1;
}

.block {
    height: auto;
    margin-bottom: 1;
}

.block-text {
    height: auto;
    padding-left: 2;
}

#footer {
    height: 2;
    border-top: solid $primary;
    background: $panel;
}

FeedPicker {
    align: center middle;
}

FeedPicker > ListView {
    width: 44;
    max-height: 20;
    border: solid $primary;
    background: $surface;
}
