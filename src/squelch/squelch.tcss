Screen {
    layout: vertical;
}

#header {
    height: 1;
    background: $panel;
}

#feeds {
    height: 1fr;
}

.feed {
    padding: 0 1;
    border-top: solid $primary;
}

/* Compact is one line plus its rule; expanded adds a one-row meter and a
   control strip. Heights are fixed rather than auto so a row cannot change
   height between a level update and a click. */
.feed.compact {
    height: 2;
}

.feed.expanded {
    height: 4;
}

/* Muted feeds dim, but their meters keep running -- muting is an audio
   gate, not a pause. */
.feed.muted {
    color: $text-disabled;
}

.feed.selected {
    background: $boost;
}

.feed-name {
    height: 1;
}

.feed-meter {
    height: 1;
}

.feed-controls {
    height: 1;
}

/* Takes no rows until something has actually been logged. With a dozen
   feeds stacked above it, a permanently reserved message area would cost
   rows the feeds themselves need. */
#messages {
    height: auto;
    max-height: 6;
    padding: 0 1;
}

.block {
    height: auto;
    margin-bottom: 1;
}

.block-text {
    height: auto;
    padding-left: 2;
}

#footer {
    height: 2;
    border-top: solid $primary;
    background: $panel;
}

FeedPicker {
    align: center middle;
}

FeedPicker > ListView {
    width: 44;
    max-height: 20;
    border: solid $primary;
    background: $surface;
}

/* Controls read as lit or dim by the row's own state. The row already dims
   wholesale when muted, so these only need to mark what is *on*. */
.feed.soloed .feed-controls {
    text-style: bold;
}

.feed.ambient .feed-name,
.feed.ambient .feed-controls {
    color: $secondary;
}

FeedPicker ListItem .picker-ident {
    color: $text-muted;
}

ConfigScreen {
    align: center middle;
}

ConfigScreen > #configbox {
    width: 44;
    height: auto;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
}
