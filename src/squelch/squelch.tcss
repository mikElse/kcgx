Screen {
    layout: vertical;
}

#header {
    height: 1;
    background: $panel;
}

#feeds {
    height: 1fr;
}

.feed {
    height: 3;
    padding: 0 1;
    border-top: solid $primary;
}

/* Muted feeds dim, but their meters keep running -- muting is an audio
   gate, not a pause. */
.feed.muted {
    color: $text-disabled;
}

.feed.selected {
    background: $boost;
}

.feed-name {
    height: 1;
}

.feed-meter {
    height: 1;
}

/* Takes no rows until something has actually been logged. With a dozen
   feeds stacked above it, a permanently reserved message area would cost
   rows the feeds themselves need. */
#messages {
    height: auto;
    max-height: 6;
    padding: 0 1;
}

.block {
    height: auto;
    margin-bottom: 1;
}

.block-text {
    height: auto;
    padding-left: 2;
}

#footer {
    height: 2;
    border-top: solid $primary;
    background: $panel;
}

FeedPicker {
    align: center middle;
}

FeedPicker > ListView {
    width: 44;
    max-height: 20;
    border: solid $primary;
    background: $surface;
}
