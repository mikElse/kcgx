Screen {
    layout: vertical;
}

#header {
    height: 1;
    background: $panel;
}

#meter {
    height: 1;
}

#transcript {
    height: 1fr;
    border-top: solid $primary;
    padding: 0 1;
}

.block {
    height: auto;
    margin-bottom: 1;
}

#footer {
    height: 2;
    border-top: solid $primary;
    background: $panel;
}
