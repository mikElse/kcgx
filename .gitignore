.venv/
__pycache__/
*.pyc

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Ambience stems: 3.4 MB of binaries that would sit in history forever.
# The manifest beside them (ambience.json) and ATTRIBUTION.md ARE tracked --
# they carry the fader positions, the per-channel credits, the licence, and
# each stem's source URL, which is what makes a checkout without the audio
# recoverable. Restore them with:
#     uv run --project . python tools/fetch_ambience.py
src/squelch/assets/audio/*.mp3

# Reference stills for the web cockpit spec; not ours to publish.
war_games_examples/

# Downloaded map sources for tools/build_geodata.py; the built map is committed.
.geo-sources/

# KCGX.app when it is built in the repo (macos/build.sh build/KCGX.app);
# setup builds it into ~/Applications.
/build/
